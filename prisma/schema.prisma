generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  contacts     Contact[]
  specialties  Specialty[]
  stickers     Sticker[]
}

model Specialty {
  id       String      @id @default(cuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  parentId String?
  parent   Specialty?  @relation("SpecialtySubcategories", fields: [parentId], references: [id], onDelete: Cascade)
  children Specialty[] @relation("SpecialtySubcategories")
  contacts Contact[]

  @@unique([userId, parentId, name])
  @@index([userId])
  @@index([parentId])
}

model Sticker {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String
  createdAt DateTime  @default(now())
  contacts  Contact[]

  @@unique([userId, name])
  @@index([userId])
}

model Contact {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  email       String?
  company     String?
  city        String?
  province    String?
  notes       String?
  isFavorite  Boolean    @default(false)
  specialtyId String?
  specialty   Specialty? @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  stickerId   String?
  sticker     Sticker?   @relation(fields: [stickerId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([userId, name])
  @@index([userId, company])
  @@index([userId, city])
  @@index([userId, specialtyId])
  @@index([userId, isFavorite])
  @@index([userId, province])
  @@index([userId, stickerId])
}
