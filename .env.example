# Conexión agrupada de Neon usada por la aplicación en tiempo de ejecución.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/agenda_bruni?sslmode=require"

# Conexión directa de Neon usada por las migraciones de Prisma y Studio.
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/agenda_bruni?sslmode=require"

# Secreto usado para firmar los JWT. Reemplácelo por una cadena larga y aleatoria.
JWT_SECRET="replace-with-a-long-random-string"
